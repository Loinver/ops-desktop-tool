{
  "name": "ops-desktop-tool",
  "version": "1.0.3",
  "description": "本机优先的 AI 运维桌面工作台",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently \"vite\" \"electron .\"",
    "build": "vite build",
    "start": "electron .",
    "mcp": "node src/main/mcp-server.js",
    "preview": "vite preview",
    "test": "node --test scripts/*.test.cjs && node scripts/check-port-parser.js && node scripts/check-renderer-api-boundaries.cjs && vitest run",
    "test:renderer": "vitest run",
    "test:renderer:watch": "vitest",
    "check": "pnpm verify && pnpm build",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{js,vue}\" \"*.{js,mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue}\" \"*.{js,mjs,json}\"",
    "test:sftp": "node --test scripts/sftp-deploy-safety.test.cjs",
    "electron:build": "vite build && electron-builder",
    "electron:build:mac": "vite build && electron-builder --mac",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:linux": "vite build && electron-builder --linux",
    "electron:build:win:arm64": "vite build && electron-builder --win --arm64",
    "electron:build:win:x64": "vite build && electron-builder --win --x64",
    "verify": "pnpm format:check && pnpm lint && pnpm test && pnpm test:e2e",
    "test:e2e": "node --test tests/e2e/*.test.cjs",
    "electron:build:mac:arm64": "vite build && electron-builder --mac --arm64",
    "electron:build:mac:x64": "vite build && electron-builder --mac --x64",
    "electron:build:mac:release": "vite build && electron-builder --mac --arm64 --x64 --config.forceCodeSigning=true"
  },
  "keywords": [
    "electron",
    "vue",
    "node",
    "ports",
    "system-tools"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.ops-desktop-tool",
    "productName": "Ops Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/renderer/assets/**/*.map",
      "src/main/**/*",
      "src/shared/**/*",
      "build/**/*",
      "package.json",
      "!node_modules/sql.js/.devcontainer/**/*",
      "!node_modules/sql.js/.eslintrc.js",
      "!node_modules/sql.js/.jsdoc.config.json",
      "!node_modules/sql.js/.nojekyll",
      "!node_modules/sql.js/AUTHORS",
      "!node_modules/sql.js/CONTRIBUTING.md",
      "!node_modules/sql.js/documentation_index.md",
      "!node_modules/sql.js/eslint.config.cjs",
      "!node_modules/sql.js/logo.svg",
      "!node_modules/sql.js/dist/sql-asm*.js",
      "!node_modules/sql.js/dist/sql-wasm-browser*",
      "!node_modules/sql.js/dist/sql-wasm-debug*",
      "!node_modules/sql.js/dist/worker.*"
    ],
    "icon": "build/icons/ops-desktop-rounded.png",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icons/ops-desktop-rounded.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icons/ops-desktop-rounded.png",
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons/ops-desktop-rounded.png"
    },
    "npmRebuild": false
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^10.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^30.0.1",
    "pinia": "^3.0.4",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tdesign-icons-vue-next": "~0.4.4",
    "tdesign-vue-next": "^1.20.1",
    "vite": "^5.4.0",
    "vitest": "^2.1.9",
    "vue": "^3.4.38",
    "vue-router": "^4.6.4"
  },
  "dependencies": {
    "sql.js": "^1.14.1",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^11.0.0"
  }
}
